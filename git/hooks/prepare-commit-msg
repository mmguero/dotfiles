#!/bin/sh
# ~/.config/git/hooks/prepare-commit-msg

SOB="Signed-off-by: $(git config user.name) <$(git config user.email)>"

if grep -v '^#' "$1" | grep -q '[^[:space:]]'; then
    git interpret-trailers --in-place --if-exists addIfDifferent \
        --trailer "$SOB" "$1"
else
    { printf '\n\n%s\n' "$SOB"; cat "$1"; } > "$1.tmp" && mv "$1.tmp" "$1"
fi
